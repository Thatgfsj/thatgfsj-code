{
  "name": "thatgfsj-code",
  "version": "3.5.0",
  "description": "Thatgfsj Code - AI Coding Assistant with Reasonix-style prompt caching",
  "main": "dist/cmd/index.js",
  "type": "module",
  "bin": {
    "thatgfsj": "./dist/cmd/index.js",
    "gfcode": "./dist/cmd/index.js",
    "gfcgfc": "./dist/cmd/index.js",
    "gfc": "./dist/cmd/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thatgfsj/thatgfsj-code.git"
  },
  "bugs": {
    "url": "https://github.com/Thatgfsj/thatgfsj-code/issues"
  },
  "homepage": "https://github.com/Thatgfsj/thatgfsj-code#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cmd/index.js",
    "dev": "tsc && node dist/cmd/index.js",
    "link": "npm link",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm test && npm run smoke",
    "smoke": "node tests/smoke-tool.mjs && node tests/smoke-tool-stream.mjs && node tests/smoke-pollution.mjs && node tests/smoke-thinking.mjs",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "ai",
    "cli",
    "coding",
    "assistant"
  ],
  "author": "Thatgfsj",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ink": "7.1.0",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "marked": "18.0.13",
    "marked-terminal": "7.3.0",
    "playwright-core": "^1.63.0",
    "react": "19.2.7",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
